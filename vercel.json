{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "rm -rf .vercel/output && npm run build",
  "framework": null,
  "crons": [
    {
      "path": "/api/cron/change-log",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/cron/change-log",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/budget-runway",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/google-trend",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/google-invoices",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/push-alerts",
      "schedule": "30 23 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/__grok/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}

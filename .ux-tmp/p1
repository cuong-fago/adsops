                <button type="button" onClick={() => draftStart && draftEnd && draftStart <= draftEnd && applyRange(draftStart, draftEnd)} className="h-10 rounded-full bg-accent px-4 text-sm font-medium text-accent-fg">Xem số</button>
                {allowCompare ? (
